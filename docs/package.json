{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "generate-docs-data": "uv run python ../scripts/generate_docs_json.py",
    "check-docs-data": "pnpm run generate-docs-data && git diff --exit-code -- src/generated",
    "check-deploy-output": "node ./scripts/verify-deploy-output.mjs",
    "check-redirects": "node ./scripts/validate-redirect-targets.mjs",
    "refresh-launcher-release": "node ./scripts/refresh-launcher-release.mjs",
    "test": "node --test \"src/**/*.test.mjs\" \"plugins/**/*.test.mjs\"",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/starlight": "^0.42.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@lucide/astro": "^1.61.0",
    "astro": "^7.4.2",
    "github-slugger": "^2.0.0",
    "mermaid": "^12.2.0",
    "rehype-external-links": "^3.0.0",
    "sharp": "^0.35.5",
    "starlight-changelogs": "^0.7.1",
    "starlight-links-validator": "^0.27.0",
    "starlight-llms-txt": "^0.12.0",
    "starlight-markdown": "^0.1.5",
    "starlight-sidebar-topics": "^0.9.0"
  },
  "devDependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0"
  },
  "packageManager": "pnpm@10.12.4"
}
