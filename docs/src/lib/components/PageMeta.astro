---
import { Icon } from '@astrojs/starlight/components';
import Pencil from '@lucide/astro/icons/pencil';

import { getReportIssueUrl } from '../report-issue';
import Trans from './Trans.astro';

const { editUrl, entry, isFallback, lang, lastUpdated, locale } = Astro.locals.starlightRoute;
// Translated pages link to Crowdin instead of their file (`src/route-data.ts`).
const { t } = Astro.locals;
const editLabel = locale && !isFallback ? t('page.translateLink') : t('page.editLink');
const reportIssueUrl = getReportIssueUrl(entry.data.title, new URL(Astro.url.pathname, Astro.site).href);
---

<div class="page-meta">
  {
    editUrl && (
      <a href={editUrl} class="print:hidden">
        <Pencil size={14} />
        {editLabel}
      </a>
    )
  }
  <a href={reportIssueUrl} class="print:hidden">
    <Icon name="github" size="14px" />
    {t('page.reportIssue')}
  </a>
  {
    lastUpdated && (
      <p>
        <Trans
          message={t('page.updated', {
            date: lastUpdated.toLocaleDateString(lang, { dateStyle: 'medium', timeZone: 'UTC' }),
            interpolation: { escapeValue: false },
          })}
        >
          {(text: string) => <time datetime={lastUpdated.toISOString()}>{text}</time>}
        </Trans>
      </p>
    )
  }
</div>

<style>
  .page-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: var(--sl-text-xs);
  }

  a {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--docs-text-muted);
    text-decoration: none;

    &:hover {
      color: var(--docs-accent-text);
    }

    @media print {
      display: none;
    }
  }

  p {
    margin: 0;
    color: var(--docs-text-subtle);
  }
</style>
