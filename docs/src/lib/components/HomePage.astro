<script>
  // The hero glow pauses while the hero and the glow around it are off screen. It runs unless marked, so a late report
  // (as in a background tab) never leaves it still. Each visit starts the light at a random point in its cycles.
  const heroShot = document.querySelector<HTMLElement>('[data-hero-shot]');
  if (heroShot) {
    new IntersectionObserver(([entry]) => heroShot.toggleAttribute('data-paused', !entry.isIntersecting), {
      rootMargin: '120px 0px',
    }).observe(heroShot);
    for (const animation of heroShot.getAnimations({ subtree: true })) {
      const duration = Number(animation.effect?.getTiming().duration);
      if (duration > 0) animation.currentTime = Math.random() * duration;
    }
  }
</script>
