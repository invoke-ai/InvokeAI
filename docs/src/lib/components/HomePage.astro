---
// The marketing home page below Starlight's hero, which renders the H1 and the tagline from the frontmatter of
// `src/content/docs/index.mdx`, and the announcement pill (`src/lib/home-announcement.mjs`). The mock app UI in the
// tour demos (`tour/`) and the What's new motifs (`whats-new/`) stays English on purpose: node, field and board names,
// buttons and the gallery's own labels mirror the English app, and their widths are tuned to that text. What speaks to
// the reader about a demo, such as its region label, keyboard hint and announcements, is a UI string.
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Download from '@lucide/astro/icons/download';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import { getSectionIcon, getTopicIcon } from '../../config/icons';
import { docsTopics, topicDescription, topicLabel } from '../../config/topics';
import { withBase } from '../base-path';
import { sortShowcase } from '../showcase.mjs';
import ModelFamilies from './ModelFamilies.astro';
import ShowcaseMarquee from './ShowcaseMarquee.astro';
import CompareImage from './compare/CompareImage.astro';
import ImageCompare from './compare/ImageCompare.astro';
import GalleryDemo from './tour/GalleryDemo.astro';
import WorkflowDemo from './tour/WorkflowDemo.astro';
import Trans from './Trans.astro';
import WhatsNewBento from './WhatsNewBento.astro';
// A copy of the app's `invokeai/frontend/webv2/src/assets/V7Logo.webp`; `src/lib/app-assets.test.mjs` keeps them equal.
import sushiAfter from '../../assets/tour/canvas/sushi-after.webp';
import sushiBefore from '../../assets/tour/canvas/sushi-before.webp';
import v7Logo from '../../assets/v7-logo.webp';
import blacksmithLogo from '../../content/docs/assets/blacksmith-logo.png';
import workbenchImage from '../../content/docs/Users Guide/assets/canvas-edit-layout.webp';

const base = import.meta.env.BASE_URL;
const href = (path: string) => withBase(path, base);
const { t } = Astro.locals;
// The tour's slider spans the wide home page column.
const compareSizes = '(min-width: 72rem) 66rem, calc(100vw - 2rem)';

const topic = (id: string) => {
  const found = docsTopics.find((candidate) => candidate.id === id);
  if (!found) throw new Error(`The home page links to the unknown docs topic "${id}".`);
  return {
    label: topicLabel(t, found),
    description: topicDescription(t, found),
    link: found.link,
    Icon: getTopicIcon(found),
  };
};

/** A directory row for a page, with the icon of the sidebar section it belongs to. */
const page = (label: string, description: string, link: string) => {
  const Icon = getSectionIcon(link);
  if (!Icon) throw new Error(`The home page directory links to ${link}, which belongs to no docs topic.`);
  return { label, description, link, Icon };
};

const paths = [
  {
    kicker: t('home.directory.create.kicker'),
    title: t('home.directory.create.title'),
    links: [topic('get-started'), topic('guide'), topic('models'), topic('troubleshooting'), topic('releases')],
  },
  {
    kicker: t('home.directory.run.kicker'),
    title: t('home.directory.run.title'),
    links: [
      topic('configure'),
      page(t('home.directory.docker.label'), t('home.directory.docker.description'), '/configuration/docker/'),
      page(
        t('home.directory.multiUser.label'),
        t('home.directory.multiUser.description'),
        '/configuration/multi-user-mode/admin-guide/'
      ),
      page(
        t('home.directory.lowVram.label'),
        t('home.directory.lowVram.description'),
        '/configuration/optimization/low-vram-mode/'
      ),
    ],
  },
  {
    kicker: t('home.directory.build.kicker'),
    title: t('home.directory.build.title'),
    links: [
      topic('developers'),
      topic('contribute'),
      page(
        t('home.directory.creatingNodes.label'),
        t('home.directory.creatingNodes.description'),
        '/development/guides/creating-nodes/'
      ),
      page(
        t('home.directory.nodePacks.label'),
        t('home.directory.nodePacks.description'),
        '/development/guides/creating-node-pack/'
      ),
    ],
  },
];

// The header has no topic links, so this directory is how the home page leads into every topic.
const listedTopics = new Set(paths.flatMap(({ links }) => links.map(({ link }) => link)));
const unlistedTopics = docsTopics.filter(({ link }) => !listedTopics.has(link)).map(({ label }) => label);
if (unlistedTopics.length > 0) {
  throw new Error(`The home page directory does not link to these docs topics: ${unlistedTopics.join(', ')}.`);
}

/*
 * The hero glow, as data for the styles below. Lengths are multiples of `--glow-unit`, which is 1px on wide screens and
 * shrinks on narrow ones, so the glow keeps its proportions to the frame.
 */
const px = (value: number) => `calc(${+value.toFixed(1)} * var(--glow-unit))`;
const alpha = (value: number) => `rgb(0 0 0 / ${value.toFixed(3)})`;
const steps = (count: number) => Array.from({ length: count + 1 }, (_, i) => i / count);

/**
 * How light from the frame's edge fades with distance: a soft shoulder (a Gaussian, so the edge has no sharp, neon-like
 * peak) over a long exponential tail, together windowed so they reach zero, with a flat slope, at `reach`.
 */
type Falloff = { reach: number; near: number; far: number; nearShare: number };
const falloff =
  ({ reach, near, far, nearShare }: Falloff) =>
  (distance: number) =>
    (1 - (distance / reach) ** 2) ** 2 *
    (nearShare * Math.exp(-((distance / near) ** 2)) + (1 - nearShare) * Math.exp(-distance / far));

/**
 * A glow's shape: the frame blurred outwards, as a vertical and a horizontal gradient whose product is the mask. The
 * top edge has full strength. Down the frame the light weakens towards `bottomLevel`, and across the outer quarters of
 * the width it eases to `sideLevel`, so the sides are dimmer than the top without a seam at the corners.
 */
const glowShape = (top: Falloff, side: Falloff, bottom: Falloff, sideLevel: number, bottomLevel: number) => {
  const [topAt, sideAt, bottomAt] = [falloff(top), falloff(side), falloff(bottom)];
  const down = (f: number) => bottomLevel + (1 - bottomLevel) * (1 - f) ** 2;
  const across = (f: number) => sideLevel + (1 - sideLevel) * (3 * f ** 2 - 2 * f ** 3);
  // Stops crowd towards the frame, where the light changes fastest.
  const fade = steps(16).map((f) => f ** 1.6);
  const frameTop = (f: number) => `calc(${px(top.reach)} + (100% - ${px(top.reach + bottom.reach)}) * ${f.toFixed(3)})`;
  const frameLeft = (f: number) => `calc(${px(side.reach)} + (100% - ${px(2 * side.reach)}) * ${f.toFixed(3)})`;
  const vertical = [
    ...fade.map((f) => `${alpha(topAt(top.reach * (1 - f)))} ${px(top.reach * f)}`),
    ...steps(8)
      .slice(1, -1)
      .map((f) => `${alpha(down(f))} ${frameTop(f)}`),
    ...fade
      .map((f) => `${alpha(bottomLevel * bottomAt(bottom.reach * f))} calc(100% - ${px(bottom.reach * (1 - f))})`)
      .reverse(),
  ];
  const left = [
    ...fade.map((f) => [alpha(sideLevel * sideAt(side.reach * (1 - f))), px(side.reach * f)]),
    ...steps(6)
      .slice(1)
      .map((f) => [alpha(across(f)), frameLeft(f / 4)]),
  ];
  const horizontal = [
    ...left.map(([a, at]) => `${a} ${at}`),
    ...left.map(([a, at]) => `${a} calc(100% - ${at})`).reverse(),
  ];
  return [
    `--glow-mask: linear-gradient(to bottom, ${vertical.join(', ')}),
      linear-gradient(to right, ${horizontal.join(', ')})`,
    `--glow-inset: ${px(-top.reach)} ${px(-side.reach)} ${px(-bottom.reach)}`,
  ].join('; ');
};

// The light near the frame, where the moving bands show, and a wide, dim, still halo around it.
const glowNear = glowShape(
  { reach: 110, near: 18, far: 40, nearShare: 0.6 },
  { reach: 80, near: 13, far: 28, nearShare: 0.6 },
  { reach: 60, near: 10, far: 20, nearShare: 0.6 },
  0.6,
  0.2
);
const glowHalo = glowShape(
  { reach: 240, near: 60, far: 90, nearShare: 0.5 },
  { reach: 170, near: 45, far: 60, nearShare: 0.5 },
  { reach: 120, near: 32, far: 45, nearShare: 0.5 },
  0.7,
  0.3
);

/**
 * The moving light seen through the near mask: soft, slanted bands of light with dark gaps between them, like the light
 * around a door as people pass in front of it. A band layer repeats every `period` along its gradient and slides
 * sideways by exactly one repeat per `drift` cycle, while its opacity swells between `low` and 1 on its own beat. Its
 * brightness follows cosines with whole-number frequencies, so the repeat is seamless and no band has an edge; raising
 * it to a power narrows the bright bands and widens the gaps. The layers slant both ways and slide in both directions
 * at different speeds, so bright patches drift along the top and up and down the sides, and the cycles share no
 * common beat.
 */
type BandLayer = {
  period: number;
  angle: number;
  harmonics: [amplitude: number, frequency: number, phase: number][];
  peak: number;
  drift: number;
  reverse?: boolean;
  swell: number;
  low: number;
};
const bandLayer = ({ period, angle, harmonics, peak, drift, reverse, swell, low }: BandLayer) => {
  const wave = (t: number) =>
    harmonics.reduce((sum, [size, f, phase]) => sum + size * Math.cos(2 * Math.PI * (f * t + phase)), 0);
  const samples = steps(40).map(wave);
  const [min, max] = [Math.min(...samples), Math.max(...samples)];
  const stops = samples.map((value, i) => {
    const level = peak * ((value - min) / (max - min)) ** 3;
    return `color-mix(in oklab, var(--docs-brand) ${(level * 100).toFixed(1)}%, transparent) ${px((period * i) / 40)}`;
  });
  // Sliding sideways by this much moves the slanted pattern along its gradient by one period.
  const shift = period / Math.sin((angle * Math.PI) / 180);
  return [
    `--light: repeating-linear-gradient(${angle}deg, ${stops.join(', ')})`,
    `--shift: ${px(shift)}`,
    `--drift: ${drift}s; --drift-direction: ${reverse ? 'reverse' : 'normal'}`,
    `--swell: ${swell}s; --swell-low: ${low}`,
  ].join('; ');
};
const glowBands = (
  [
    {
      period: 980,
      angle: 118,
      harmonics: [[1, 1, 0], [0.6, 2, 0.31], [0.35, 3, 0.62]],
      peak: 0.42,
      drift: 47,
      swell: 9.7,
      low: 0.45,
    },
    {
      period: 1620,
      angle: 63,
      harmonics: [[1, 1, 0.18], [0.7, 2, 0.77], [0.3, 4, 0.4]],
      peak: 0.4,
      drift: 61,
      reverse: true,
      swell: 13.1,
      low: 0.4,
    },
    {
      period: 610,
      angle: 97,
      harmonics: [[1, 1, 0.5], [0.5, 2, 0.05], [0.25, 3, 0.9]],
      peak: 0.34,
      drift: 23,
      reverse: true,
      swell: 6.9,
      low: 0.3,
    },
  ] satisfies BandLayer[]
).map(bandLayer);

const showcase = sortShowcase(await getCollection('showcase')).slice(0, 12);

const community = [
  { label: t('home.community.showcaseLink'), link: href('/showcase/') },
  { label: t('home.community.discordLink'), link: 'https://discord.gg/ZmtBAhwWhy' },
  { label: t('home.community.githubLink'), link: 'https://github.com/invoke-ai/InvokeAI' },
  { label: t('home.community.sponsorLink'), link: 'https://github.com/sponsors/invoke-ai' },
  { label: t('home.community.trainingLink'), link: 'https://github.com/invoke-ai/invoke-training' },
];

/** The pages the install paragraph links, by the tag around each link's text in `home.install.body`. */
const installLinks: Record<string, string> = {
  requirements: '/start-here/system-requirements/',
  manual: '/start-here/manual/',
  docker: '/configuration/docker/',
};

---

<div class="home not-content">
  <div class="intro">
    <div class="cta">
      <div class="cta__buttons">
        <a class="docs-button docs-button--primary docs-button--xl" href={href('/download/')}>
          <Download aria-hidden="true" />
          {t('home.cta.download')}
        </a>
        <a class="docs-button docs-button--secondary docs-button--xl" href={href(topic('get-started').link)}>
          {t('home.cta.readDocs')}
          <ArrowRight class="nudge" aria-hidden="true" />
        </a>
      </div>
      <p class="cta__platforms">{t('home.cta.platformsAndLicense')}</p>
    </div>

    <figure class="hero-shot" data-hero-shot>
      <span class="hero-glow hero-glow--halo" style={glowHalo} aria-hidden="true"></span>
      <span class="hero-glow hero-glow--near" style={glowNear} aria-hidden="true">
        {glowBands.map((style) => <span class="hero-glow__light" style={style} />)}
      </span>
      <div class="frame frame--hero">
        <Image
          src={workbenchImage}
          alt={t('home.hero.screenshotAlt')}
          widths={[640, 960, 1280, 1600, 2000, 2560, workbenchImage.width]}
          sizes="(min-width: 50rem) min(calc(100vw - 3rem), 90rem), calc(100vw - 2rem)"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </figure>
  </div>

  <section class="tour" aria-label={t('home.tour.label')}>
    <div class="tour__item">
      <div class="tour__intro">
        <div class="heading">
          <p class="eyebrow">{t('home.tour.canvas.eyebrow')}</p>
          <h2>{t('home.tour.canvas.title')}</h2>
        </div>
        <div class="tour__text">
          <p>{t('home.tour.canvas.body')}</p>
          <a class="more" href={href('/users-guide/canvas/introduction/')}>
            {t('home.tour.canvas.link')}
            <ArrowRight class="nudge" size={14} aria-hidden="true" />
          </a>
        </div>
      </div>
      {/*
        One inpainting edit: the third roll was masked and regenerated as a salmon roe roll. Both images are crops of
        `Users Guide/assets/canvas-inpaint-result.webp` at the same size and offset; the inpaint mask's hatch lines were
        removed from the before crop by interpolating each from its unmasked neighbours, leaving the original roll.
      */}
      <ImageCompare label={t('home.tour.canvas.compare.label')}>
        <CompareImage
          slot="before"
          src={sushiBefore}
          alt={t('home.tour.canvas.compare.beforeAlt')}
          label={t('home.tour.canvas.compare.before')}
          sizes={compareSizes}
        />
        <CompareImage
          slot="after"
          src={sushiAfter}
          alt={t('home.tour.canvas.compare.afterAlt')}
          label={t('home.tour.canvas.compare.after')}
          sizes={compareSizes}
        />
      </ImageCompare>
    </div>

    <!-- The workflow demo's nodes can be dragged anywhere in this row, over its copy too. -->
    <div class="tour__item tour__item--split tour__item--workflow" data-workflow-bounds>
      <div class="tour__text">
        <div class="heading">
          <p class="eyebrow">{t('home.tour.workflows.eyebrow')}</p>
          <h2>{t('home.tour.workflows.title')}</h2>
        </div>
        <p>{t('home.tour.workflows.body')}</p>
        <a class="more" href={href('/users-guide/workflows/introduction/')}>
          {t('home.tour.workflows.link')}
          <ArrowRight class="nudge" size={14} aria-hidden="true" />
        </a>
      </div>
      <WorkflowDemo />
    </div>

    <div class="tour__item tour__item--split tour__item--reverse tour__item--gallery">
      <div class="tour__text">
        <div class="heading">
          <p class="eyebrow">{t('home.tour.gallery.eyebrow')}</p>
          <h2>{t('home.tour.gallery.title')}</h2>
        </div>
        <p>{t('home.tour.gallery.body')}</p>
        <a class="more" href={href('/users-guide/gallery/introduction/')}>
          {t('home.tour.gallery.link')}
          <ArrowRight class="nudge" size={14} aria-hidden="true" />
        </a>
      </div>
      <GalleryDemo class="gallery-demo-slot" />
    </div>
  </section>

  {
    showcase.length > 0 && (
      <section class="section" aria-labelledby="home-showcase">
        <div class="section__top">
          <div class="heading">
            <p class="eyebrow">{t('home.showcase.eyebrow')}</p>
            <h2 id="home-showcase">{t('home.showcase.title')}</h2>
          </div>
          <a class="more" href={href('/showcase/')}>
            {t('home.showcase.link')}
            <ArrowRight class="nudge" size={14} aria-hidden="true" />
          </a>
        </div>
        <ShowcaseMarquee entries={showcase} />
      </section>
    )
  }

  <section class="section" aria-labelledby="home-new">
    <WhatsNewBento>
      <div class="section__header">
        <Image class="logo" src={v7Logo} alt="" widths={[96, 128, 256]} sizes="(min-width: 50rem) 7rem, 5rem" />
        <div class="heading">
          <p class="eyebrow">{t('home.whatsNew.eyebrow')}</p>
          <h2 id="home-new">{t('home.whatsNew.title')}</h2>
        </div>
      </div>
    </WhatsNewBento>
  </section>

  <section class="section" aria-labelledby="home-models">
    <ModelFamilies>
      <div class="section__top">
        <div class="heading">
          <p class="eyebrow">{t('home.models.eyebrow')}</p>
          <h2 id="home-models">{t('home.models.title')}</h2>
          <p class="section__intro">{t('home.models.intro')}</p>
        </div>
        <a class="more" href={href('/users-guide/models/model-families/')}>
          {t('home.models.link')}
          <ArrowRight class="nudge" size={14} aria-hidden="true" />
        </a>
      </div>
    </ModelFamilies>
  </section>

  <section class="section" aria-labelledby="home-directory">
    <div class="heading">
      <p class="eyebrow">{t('home.directory.eyebrow')}</p>
      <h2 id="home-directory">{t('home.directory.title')}</h2>
    </div>
    <div class="paths">
      {
        paths.map(({ kicker, title, links }) => (
          <div class="card path">
            <div class="path__heading">
              <p class="label">{kicker}</p>
              <h3>{title}</h3>
            </div>
            <ul class="path__links" role="list">
              {links.map(({ label, description, link, Icon }) => (
                <li>
                  <a href={href(link)}>
                    <span class="path__icon">
                      <Icon size={16} aria-hidden="true" />
                    </span>
                    <span class="path__label">{label}</span>
                    <span class="path__description">{description}</span>
                    <ArrowRight class="path__arrow nudge" size={16} aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="card community" aria-labelledby="home-community">
    <div class="community__text">
      <div class="heading">
        <p class="eyebrow">{t('home.community.eyebrow')}</p>
        <h2 id="home-community">{t('home.community.title')}</h2>
      </div>
      <p>
        <Trans message={t('home.community.body')}>
          {(text: string) => <a href={href('/contributing/contributors/')}>{text}</a>}
        </Trans>
      </p>
      <a class="sponsor" href="https://www.blacksmith.sh/">
        <Image src={blacksmithLogo} alt={t('home.community.sponsorAlt')} width={240} densities={[1, 2]} />
      </a>
    </div>
    <ul class="community__links" role="list">
      {
        community.map(({ label, link }) => (
          <li>
            <a href={link}>
              {label}
              <ArrowRight class="nudge" size={16} aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="card install" aria-labelledby="home-install">
    <div class="install__text">
      <h2 id="home-install">{t('home.install.title')}</h2>
      <p>
        <Trans message={t('home.install.body')}>
          {(text: string, tag: string) => (installLinks[tag] ? <a href={href(installLinks[tag])}>{text}</a> : text)}
        </Trans>
      </p>
    </div>
    <div class="install__buttons">
      <a class="docs-button docs-button--primary docs-button--lg" href={href('/download/')}>
        {t('home.install.downloadLauncher')}
      </a>
      <a class="docs-button docs-button--secondary docs-button--lg" href={href('/start-here/installation/')}>
        {t('home.install.guide')}
      </a>
    </div>
  </section>
</div>

<style>
  /*
   * Starlight's hero lays out an image beside the copy. Here its image slot holds the beta pill, so stack and centre
   * everything; the spacing below the hero belongs to this component.
   */
  :global(.hero:has(.home-announcement)) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding-bottom: 0;
    text-align: center;

    > :global(.hero-html) {
      order: 0;
      width: auto;
      max-width: 100%;
      margin: 0;
    }

    :global(.stack) {
      align-items: center;
      gap: 1.25rem;
      text-align: center;
    }

    :global(.copy) {
      align-items: center;
      gap: 1.25rem;
    }

    :global(.tagline) {
      max-width: 40rem;
      font-size: clamp(1rem, 0.9rem + 0.5vw, 1.125rem);
      line-height: 1.6;
    }
  }

  :global(.home-announcement) {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 0.5rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid color-mix(in oklab, var(--docs-accent) 35%, transparent);
    border-radius: 1rem;
    background-color: var(--docs-accent-tint);
    color: var(--docs-accent-text);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.5;
    text-decoration: none;

    &:hover {
      border-color: color-mix(in oklab, var(--docs-accent) 60%, transparent);
      background-color: color-mix(in oklab, var(--docs-accent) 22%, transparent);
      color: var(--docs-text-strong);
    }

    > :global(span) {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
  }

  /* Narrow screens put the call to action on a line of its own, without a separator to start it. */
  @media (max-width: 23.99rem) {
    :global(.home-announcement__separator) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.home-announcement__arrow) {
      transition: translate 150ms ease;
    }

    :global(.home-announcement:is(:hover, :focus-visible) .home-announcement__arrow) {
      translate: 2px 0;
    }
  }

  :global(.home-announcement__dot) {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--docs-accent);
  }

  .home {
    display: flex;
    flex-direction: column;
    gap: clamp(4.5rem, 2.5rem + 6vw, 7rem);
    padding-bottom: clamp(1rem, 4vw, 3rem);
    color: var(--docs-text-strong);
    font-size: 1rem;
    line-height: 1.6;
  }

  p {
    margin: 0;
  }

  h2,
  h3 {
    margin: 0;
    color: var(--docs-text-strong);
  }

  h2 {
    font-size: clamp(1.75rem, 1.35rem + 1.6vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    max-width: 40rem;
  }

  .eyebrow {
    color: var(--docs-accent);
