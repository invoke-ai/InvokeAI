---
/* One step of a `Pipeline` or a `PipelineLane`: a title and an optional short description. See `Pipeline.astro`. */
type Props = {
  title: string;
  description?: string;
};

const { title, description } = Astro.props;
---

<li class="pipeline__item">
  <div class="step">
    <strong class="step__title">{title}</strong>
    {description && <span class="step__description">{description}</span>}
  </div>
</li>

<style>
  .step {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 0.125rem;
    min-width: 0;
    min-height: 3.25rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--docs-border-strong);
    border-radius: var(--docs-radius-lg);
    background-color: var(--docs-control);
    text-align: center;
    text-wrap: balance;
  }

  .step__title {
    color: var(--docs-text-strong);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.3;
  }

  .step__description {
    color: var(--docs-text-muted);
    font-size: var(--sl-text-xs);
    line-height: 1.35;
  }
</style>
