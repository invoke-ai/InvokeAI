        return;
      }
      if (!target.matches('[data-tile-select]') || !event.key.startsWith('Arrow')) return;
      const next = tileInDirection(tile, event.key);
      if (!next) return;
      event.preventDefault();
      setTabStop(next);
      const button = next.querySelector<HTMLElement>('[data-tile-select]')!;
      button.focus({ preventScroll: true });
      button.scrollIntoView({ block: 'nearest', inline: 'nearest' });
