        control.setAttribute('aria-label', `Image sort: ${label}`);
        renderGrid();
      } else if (control.matches('[data-section-trigger], [data-strip-trigger]')) {
        const isOpen = control.getAttribute('aria-expanded') !== 'true';
        control.setAttribute('aria-expanded', String(isOpen));
        document.getElementById(control.getAttribute('aria-controls')!)!.hidden = !isOpen;
        if (control.matches('[data-strip-trigger]')) setTabStop(activeTile?.isConnected && !activeTile.closest('[hidden]') ? activeTile : visibleTiles()[0] ?? null);
      } else if (control.matches('[data-crumb]')) {
        const isOpen = control.getAttribute('aria-expanded') !== 'true';
        control.setAttribute('aria-expanded', String(isOpen));
        $('[data-boards-panel]').hidden = !isOpen;
        $('[data-resize]').hidden = !isOpen;
      } else if (control.matches('[data-clear-board-search]')) {
        boardSearch.value = '';
        state.boardSearch = '';
        renderBoards();
        boardSearch.focus();
      } else if (control.matches('[data-clear-item-search]')) {
        itemSearch.value = '';
        itemSearch.dispatchEvent(new Event('input'));
        itemSearch.focus();
      }
    });

    // The segment tabs' roving focus: arrows cycle, Home and End jump; Enter or Space selects.
    $('[data-tabs]').addEventListener('keydown', (event) => {
      const index = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (index === -1 || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const next =
        event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
      tabs[next]!.focus();
    });

    grid.addEventListener('focusin', (event) => {
      const tile = (event.target as Element).closest<HTMLElement>('[data-item-id]');
      if (tile && tile !== activeTile) setTabStop(tile);
    });
    grid.addEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
