---
import { getCurrentTopic } from '../../config/topics';
import { withBase } from '../base-path';
import { findCurrentTrail } from '../sidebar.mjs';

const { entry, sidebar } = Astro.locals.starlightRoute;
const topic = getCurrentTopic(Astro.locals);
const trail = topic && findCurrentTrail(sidebar);
// The breadcrumb carries the Pagefind `topic` filter that scopes search to a topic, on pages Pagefind indexes; its
// text is not indexed.
const topicFilter = topic && entry.data.pagefind !== false ? `topic:${topic.label}` : undefined;
---

<div class="page-heading">
  {
    topic && (
      <nav aria-label="Breadcrumb" data-pagefind-ignore data-pagefind-filter={topicFilter}>
        <ol>
          <li>
            <a href={withBase(topic.link, import.meta.env.BASE_URL)}>{topic.label}</a>
          </li>
          {trail?.groups.map((group) => <li>{group}</li>)}
          {trail && <li aria-current="page">{trail.link.label}</li>}
        </ol>
      </nav>
    )
  }
  {/* Starlight links to the page title as `#_top`. */}
  <h1 id="_top">{entry.data.title}</h1>
</div>

<style>
  .page-heading {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--docs-text-subtle);
    font-size: var(--sl-text-xs);
  }

  li + li::before {
    content: '/';
    content: '/' / '';
    margin-inline-end: 0.375rem;
  }

  a {
    color: inherit;
    text-decoration: none;

    &:hover {
      color: var(--docs-text-strong);
    }
  }

  [aria-current='page'] {
    color: var(--docs-text-muted);
  }

  h1 {
    margin: 0;
    color: var(--docs-text-strong);
    font-size: var(--sl-text-h1);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
</style>
