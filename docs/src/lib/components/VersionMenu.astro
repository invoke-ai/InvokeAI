---
import Check from '@lucide/astro/icons/check';
import ChevronDown from '@lucide/astro/icons/chevron-down';

import { withBase } from '../base-path';

// v7 is this site; the v6 docs stay at invoke.ai, deployed from the v6-bugfixes branch.
const versions = [
  { label: 'v7', note: 'Current', href: withBase('/', import.meta.env.BASE_URL), isCurrent: true },
  { label: 'v6', note: 'Previous release', href: 'https://invoke.ai/', isCurrent: false },
];
---

<docs-version-menu class="version-menu">
  <button
    type="button"
    class="trigger docs-button docs-button--secondary docs-button--lg"
    aria-expanded="false"
    aria-controls="docs-version-menu-list"
    aria-label="Docs version: v7"
  >
    v7
    <ChevronDown size={12} />
  </button>
  <ul id="docs-version-menu-list" class="popup docs-popup" hidden>
    {
      versions.map(({ label, note, href, isCurrent }) => (
        <li>
          <a href={href} aria-current={isCurrent ? 'true' : undefined}>
            <span class="label">{label}</span>
            <span class="note">{note}</span>
            {isCurrent && (
              <Check class="check" size={14} />
            )}
          </a>
        </li>
      ))
    }
  </ul>
</docs-version-menu>

<script>
  import { bindDisclosure } from '../disclosure';

  class DocsVersionMenu extends HTMLElement {
    connectedCallback() {
      bindDisclosure(this, this.querySelector('button')!, this.querySelector('ul')!);
    }
  }
  customElements.define('docs-version-menu', DocsVersionMenu);
</script>

<style>
  .version-menu {
    position: relative;
  }

  .popup {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.375rem);
    z-index: 1;
    min-width: 12rem;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    border: 1px solid var(--docs-border-strong);
    border-radius: var(--docs-radius-lg);
    background: var(--docs-control);
    box-shadow: var(--docs-shadow-popup);
  }

  a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: var(--docs-radius);
    color: var(--docs-text-strong);
    text-decoration: none;

    &:hover {
      background: var(--docs-hover);
    }
  }

  .label {
    font-weight: 600;
  }

  .note {
    flex: 1;
    color: var(--docs-text-subtle);
  }

  .check {
    color: var(--docs-accent);
  }
</style>
