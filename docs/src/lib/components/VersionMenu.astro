---
import { localizedHref } from '../base-path';
import LinkMenu from './LinkMenu.astro';

// v7 is this site; the v6 docs stay at invoke.ai, deployed from the v6-bugfixes branch.
const { locale } = Astro.locals.starlightRoute;
const versions = [
  {
    label: 'v7',
    note: 'Current',
    href: localizedHref('/', { locale, base: import.meta.env.BASE_URL }),
    isCurrent: true,
  },
  { label: 'v6', note: 'Previous release', href: 'https://invoke.ai/', isCurrent: false },
];
---

<LinkMenu id="docs-version-menu-list" label="v7" accessibleLabel="Docs version: v7" items={versions} />
